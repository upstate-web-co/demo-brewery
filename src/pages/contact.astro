---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/config'

const sent = Astro.url.searchParams.get('sent') === 'true'
const error = Astro.url.searchParams.get('error')
---

<BaseLayout title="Contact — Clinker Brewing Co." description="Find Clinker Brewing Co. at 412 S Main St, Greenville, SC. Hours, directions, private event booking, and contact form.">

  <!-- Hero banner -->
  <section class="relative py-28 md:py-36 px-6 overflow-hidden grain">
    <img
      src="https://images.unsplash.com/photo-1567696911980-2eed69a46042?w=1600&q=80"
      alt="Clinker Brewing exterior at dusk on South Main Street"
      class="absolute inset-0 w-full h-full object-cover brightness-[0.15]"
      loading="eager"
      width="1600"
      height="900"
    />
    <div class="relative z-10 max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-cream reveal">Find Us</h1>
      <hr class="amber-rule reveal delay-1" />
      <p class="text-warm-light/60 text-lg mt-4 reveal delay-2">
        {SITE.address}
      </p>
    </div>
  </section>

  <!-- Quick info bar — mobile UX: hours visible immediately -->
  <section class="bg-coal-lighter border-y border-slag/15 py-6 px-6" aria-label="Quick info">
    <div class="mx-auto max-w-5xl grid grid-cols-2 md:grid-cols-4 gap-4 text-center text-sm">
      <div>
        <p class="text-amber font-heading font-semibold uppercase tracking-wider text-xs">Today</p>
        <p class="text-warm-light mt-1 font-medium">
          {(() => {
            const days = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'] as const
            return SITE.hours[days[new Date().getDay()]]
          })()}
        </p>
      </div>
      <div>
        <p class="text-amber font-heading font-semibold uppercase tracking-wider text-xs">Phone</p>
        <p class="mt-1"><a href={`tel:${SITE.phone}`} class="text-warm-light hover:text-amber transition-colors">{SITE.phone}</a></p>
      </div>
      <div>
        <p class="text-amber font-heading font-semibold uppercase tracking-wider text-xs">Email</p>
        <p class="mt-1"><a href={`mailto:${SITE.email}`} class="text-warm-light hover:text-amber transition-colors truncate">{SITE.email}</a></p>
      </div>
      <div>
        <p class="text-amber font-heading font-semibold uppercase tracking-wider text-xs">Parking</p>
        <p class="text-warm-light mt-1">Street + free lot behind building</p>
      </div>
    </div>
  </section>

  <!-- Private Events callout -->
  <section class="bg-amber/5 border-b border-amber/15 py-6 px-6">
    <div class="mx-auto max-w-5xl flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl" aria-hidden="true">🎉</span>
        <div>
          <p class="text-warm-light font-semibold text-sm">Planning a private event?</p>
          <p class="text-slag text-xs">Birthdays, corporate events, rehearsal dinners — 80 seated, 120 standing.</p>
        </div>
      </div>
      <a href="#contact-form" class="shrink-0 rounded-lg bg-amber px-5 py-2.5 text-sm font-semibold text-coal hover:bg-amber-light transition-colors">
        Inquire About Private Events
      </a>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-20 md:py-28 px-6">
    <div class="mx-auto max-w-5xl grid md:grid-cols-2 gap-16">

      <!-- Left: Info -->
      <div>
        <!-- Hours -->
        <div class="reveal">
          <h2 class="text-2xl font-bold text-amber font-heading uppercase tracking-wide mb-6">Hours</h2>
          <div class="space-y-3">
            {Object.entries(SITE.hours).map(([day, hours]) => (
              <div class={`flex justify-between items-center py-2.5 px-4 rounded-lg text-sm ${hours === 'Closed' ? 'bg-coal-lighter/50' : 'bg-coal-lighter border border-slag/10'}`}>
                <span class="text-warm-light font-medium capitalize">{day === 'mon' ? 'Monday' : day === 'tue' ? 'Tuesday' : day === 'wed' ? 'Wednesday' : day === 'thu' ? 'Thursday' : day === 'fri' ? 'Friday' : day === 'sat' ? 'Saturday' : 'Sunday'}</span>
                <span class={hours === 'Closed' ? 'text-red-400/70' : 'text-slag'}>{hours}</span>
              </div>
            ))}
          </div>
          <p class="text-xs text-slag mt-3">Walk-ins welcome. No reservations for the taproom. Dogs on the patio. Kids until 8pm.</p>
        </div>

        <!-- Map placeholder -->
        <div class="mt-10 reveal delay-1">
          <h2 class="text-2xl font-bold text-amber font-heading uppercase tracking-wide mb-4">Directions</h2>
          <div class="rounded-xl overflow-hidden border border-slag/20 aspect-video bg-coal-lighter flex items-center justify-center">
            <div class="text-center p-6">
              <svg class="w-10 h-10 text-slag/40 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
              <p class="text-warm-light font-medium text-sm">{SITE.address}</p>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE.address)}`}
                target="_blank"
                rel="noopener"
                class="inline-block mt-3 text-amber text-sm font-medium hover:text-amber-light transition-colors"
              >
                Open in Google Maps &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Social -->
        <div class="mt-10 reveal delay-2">
          <h2 class="text-2xl font-bold text-amber font-heading uppercase tracking-wide mb-4">Follow Along</h2>
          <div class="flex flex-wrap gap-3">
            <a
              href={SITE.social.instagram}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-3 rounded-xl border border-slag/20 bg-coal-lighter px-5 py-3.5 text-sm font-medium text-warm-light hover:border-amber/30 hover:text-amber transition-colors min-h-[44px]"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              Instagram
            </a>
            <a
              href={SITE.social.untappd}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-3 rounded-xl border border-slag/20 bg-coal-lighter px-5 py-3.5 text-sm font-medium text-warm-light hover:border-amber/30 hover:text-amber transition-colors min-h-[44px]"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M11.7 8.5L9.2 4.1c-.3-.5-.9-.7-1.4-.5l-2 .8c-.5.2-.8.8-.6 1.3l2.7 5.1c.2.3.5.5.9.5h.5c.4 0 .7-.2.9-.5l1.5-2.3zm.6 0l1.5 2.3c.2.3.5.5.9.5h.5c.4 0 .7-.2.9-.5l2.7-5.1c.2-.5-.1-1.1-.6-1.3l-2-.8c-.5-.2-1.1 0-1.4.5L12.3 8.5zM12 10.5l-2.3 3.5c-.3.5-.1 1.1.4 1.4l2 1.2c.5.3 1.1.1 1.4-.4l.5-.8.5.8c.3.5.9.7 1.4.4l2-1.2c.5-.3.7-.9.4-1.4L14.3 10.5h-2.3z"/></svg>
              Untappd
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Contact Form -->
      <div class="reveal delay-1" id="contact-form">
        <h2 class="text-2xl font-bold text-amber font-heading uppercase tracking-wide mb-6">Send a Message</h2>

        <!-- Success message -->
        {sent && (
          <div class="rounded-xl bg-green-900/20 border border-green-500/30 p-5 mb-6" role="alert">
            <p class="text-green-400 font-semibold text-sm">Message sent!</p>
            <p class="text-green-400/70 text-sm mt-1">Thanks for reaching out. We'll get back to you within 24 hours.</p>
          </div>
        )}

        <!-- Error message -->
        {error && (
          <div class="rounded-xl bg-red-900/20 border border-red-500/30 p-5 mb-6" role="alert">
            <p class="text-red-400 font-semibold text-sm">Something went wrong</p>
            <p class="text-red-400/70 text-sm mt-1">{error}</p>
          </div>
        )}

        <form method="POST" action="/api/contact" class="space-y-5">
          <!-- Honeypot — hidden from humans, bots will fill it -->
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="name" class="block text-sm font-medium text-warm-light mb-1.5">Name <span class="text-amber" aria-hidden="true">*</span></label>
            <input
              type="text" id="name" name="name" required autocomplete="name" minlength="2" maxlength="200"
              class="w-full bg-coal rounded-xl border border-slag/25 px-4 py-3 text-sm text-warm-light placeholder:text-slag/50 focus:border-amber focus:ring-1 focus:ring-amber/30 focus:outline-none transition-colors"
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-warm-light mb-1.5">Email <span class="text-amber" aria-hidden="true">*</span></label>
            <input
              type="email" id="email" name="email" required autocomplete="email" maxlength="200"
              class="w-full bg-coal rounded-xl border border-slag/25 px-4 py-3 text-sm text-warm-light placeholder:text-slag/50 focus:border-amber focus:ring-1 focus:ring-amber/30 focus:outline-none transition-colors"
              placeholder="you@example.com"
            />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-warm-light mb-1.5">Phone <span class="text-slag text-xs">(optional)</span></label>
            <input
              type="tel" id="phone" name="phone" autocomplete="tel"
              class="w-full bg-coal rounded-xl border border-slag/25 px-4 py-3 text-sm text-warm-light placeholder:text-slag/50 focus:border-amber focus:ring-1 focus:ring-amber/30 focus:outline-none transition-colors"
              placeholder="(864) 555-0000"
            />
          </div>
          <div>
            <label for="subject" class="block text-sm font-medium text-warm-light mb-1.5">Subject <span class="text-amber" aria-hidden="true">*</span></label>
            <select
              id="subject" name="subject" required
              class="w-full bg-coal rounded-xl border border-slag/25 px-4 py-3 text-sm text-warm-light focus:border-amber focus:ring-1 focus:ring-amber/30 focus:outline-none transition-colors"
            >
              <option value="">Select a topic...</option>
              <option value="general">General Inquiry</option>
              <option value="private-events">Private Event Space</option>
              <option value="furnace-sessions">Furnace Sessions Booking</option>
              <option value="press">Press / Media</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-warm-light mb-1.5">Message <span class="text-amber" aria-hidden="true">*</span></label>
            <textarea
              id="message" name="message" rows="5" required minlength="10" maxlength="5000"
              class="w-full bg-coal rounded-xl border border-slag/25 px-4 py-3 text-sm text-warm-light placeholder:text-slag/50 focus:border-amber focus:ring-1 focus:ring-amber/30 focus:outline-none transition-colors resize-none"
              placeholder="Tell us what's on your mind..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full rounded-xl bg-amber px-6 py-3.5 font-semibold text-coal hover:bg-amber-light transition-colors min-h-[44px]"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
