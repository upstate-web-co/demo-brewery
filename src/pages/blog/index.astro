---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

export const prerender = true

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)
---

<BaseLayout title="Blog — Clinker Brewing Co." description="Barrel-aged releases, tap list updates, Furnace Sessions lineups, and stories from the brewery.">

  <!-- Hero banner -->
  <section class="relative py-28 md:py-36 px-6 overflow-hidden grain">
    <img
      src="https://images.unsplash.com/photo-1558642452-9d2a7deb7f62?w=1600&q=80"
      alt="Craft beer flight at Clinker Brewing"
      class="absolute inset-0 w-full h-full object-cover brightness-[0.15]"
      loading="eager"
    />
    <div class="relative z-10 max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-cream reveal">From the Brewery</h1>
      <hr class="amber-rule reveal delay-1" />
      <p class="text-warm-light/60 text-lg mt-4 reveal delay-2">
        Releases, lineups, and stories from behind the bar.
      </p>
    </div>
  </section>

  <!-- Posts grid -->
  <section class="py-20 md:py-28 px-6">
    <div class="mx-auto max-w-5xl">
      {posts.length === 0 ? (
        <p class="text-slag text-center text-lg">No posts yet. Check back soon.</p>
      ) : (
        <div class="grid md:grid-cols-2 gap-8">
          {posts.map((post, i) => (
            <article class={`reveal group ${i === 0 ? '' : `delay-${Math.min(i, 3)}`}`}>
              <a href={`/blog/${post.id}`} class="block rounded-2xl overflow-hidden border border-slag/15 bg-coal-lighter transition-all duration-300 hover:-translate-y-1 hover:border-amber/25 hover:shadow-xl">
                {post.data.image && (
                  <div class="overflow-hidden">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="w-full aspect-[16/9] object-cover group-hover:scale-105 transition-transform duration-700"
                      loading={i < 2 ? 'eager' : 'lazy'}
                    />
                  </div>
                )}
                <div class="p-6">
                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-3">
                      {post.data.tags.slice(0, 3).map((tag: string) => (
                        <span class="text-xs bg-amber/10 text-amber px-2.5 py-1 rounded-full font-medium uppercase tracking-wider">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <h2 class="font-heading text-xl font-bold text-warm-light uppercase tracking-wide group-hover:text-amber transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-slag text-sm mt-3 line-clamp-3 leading-relaxed">
                    {post.data.description}
                  </p>
                  <div class="flex items-center justify-between mt-5 pt-4 border-t border-slag/10">
                    <span class="text-xs text-slag">
                      {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                    </span>
                    <span class="text-xs text-amber font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                      Read
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

</BaseLayout>
